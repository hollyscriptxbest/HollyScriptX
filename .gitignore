<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HollyScriptX</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg1:#3a1c71;
    --bg2:#6a3093;
    --bg3:#1c3a5e;
    --violet:#8b5cf6;
    --cyan:#4fd1c5;
    --ink:#0d0a1a;
    --text:#f2eefc;
    --text-dim:#b8b0d4;
    --glass:rgba(255,255,255,0.08);
    --glass-border:rgba(255,255,255,0.18);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--text);
    background:
      radial-gradient(circle at 15% 20%, rgba(139,92,246,0.35), transparent 45%),
      radial-gradient(circle at 85% 15%, rgba(79,209,197,0.25), transparent 40%),
      radial-gradient(circle at 50% 90%, rgba(106,48,147,0.4), transparent 50%),
      linear-gradient(160deg, var(--ink) 0%, #150f2e 45%, #0d0a1a 100%);
    background-attachment:fixed;
    min-height:100vh;
    overflow-x:hidden;
  }
  .display{font-family:'Space Grotesk',sans-serif;}
  ::selection{background:var(--violet); color:#fff;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }

  a:focus-visible, button:focus-visible{outline:2px solid var(--cyan); outline-offset:3px;}

  /* floating orbs */
  .orb{
    position:fixed;
    border-radius:50%;
    filter:blur(60px);
    z-index:0;
    pointer-events:none;
    opacity:0.5;
  }
  .orb1{width:420px; height:420px; background:var(--violet); top:-100px; right:-100px; animation:float1 18s ease-in-out infinite;}
  .orb2{width:340px; height:340px; background:var(--cyan); bottom:5%; left:-80px; animation:float2 22s ease-in-out infinite;}
  @keyframes float1{0%,100%{transform:translate(0,0);} 50%{transform:translate(-40px,60px);}}
  @keyframes float2{0%,100%{transform:translate(0,0);} 50%{transform:translate(50px,-40px);}}

  /* glass base */
  .glass{
    background:var(--glass);
    border:1px solid var(--glass-border);
    backdrop-filter:blur(20px) saturate(160%);
    -webkit-backdrop-filter:blur(20px) saturate(160%);
    border-radius:20px;
    box-shadow:0 8px 32px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
  }

  /* nav */
  .nav{
    position:fixed; top:18px; left:50%; transform:translateX(-50%);
    z-index:50;
    width:min(920px, 92%);
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 22px;
    border-radius:999px;
  }
  .brand{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:1.05rem;
    text-decoration:none;
    color:var(--text);
    letter-spacing:0.01em;
  }
  .brand span{
    background:linear-gradient(90deg, var(--cyan), var(--violet));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .nav-links{display:flex; gap:28px; align-items:center;}
  .nav-links a{
    color:var(--text-dim);
    text-decoration:none;
    font-size:0.9rem;
    font-weight:500;
    transition:color .2s;
  }
  .nav-links a:hover{color:var(--text);}
  .nav-cta{
    color:var(--ink) !important;
    background:linear-gradient(90deg, var(--cyan), var(--violet));
    padding:9px 18px;
    border-radius:999px;
    font-weight:600 !important;
    font-size:0.85rem !important;
  }
  @media (max-width:720px){ .nav-links a:not(.nav-cta){display:none;} }

  /* hero */
  .hero{
    position:relative;
    z-index:1;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:160px 20px 100px;
  }
  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding:8px 16px;
    border-radius:999px;
    font-size:0.8rem;
    color:var(--text-dim);
    margin-bottom:28px;
  }
  .pill .dot{width:7px; height:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 10px var(--cyan);}
  h1{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(2.4rem,6.5vw,4.6rem);
    line-height:1.08;
    margin:0 0 24px;
    max-width:16ch;
    text-wrap:balance;
  }
  h1 .grad{
    background:linear-gradient(90deg, var(--cyan), var(--violet) 70%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .hero p.deck{
    font-size:clamp(1rem,2vw,1.15rem);
    color:var(--text-dim);
    max-width:48ch;
    line-height:1.7;
    margin:0 0 40px;
  }
  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-bottom:70px;}
  .btn{
    font-weight:600;
    font-size:0.95rem;
    padding:15px 28px;
    border-radius:14px;
    text-decoration:none;
    display:inline-block;
    transition:transform .2s ease, box-shadow .2s ease, background .2s;
  }
  .btn:hover{transform:translateY(-3px);}
  .btn-primary{
    background:linear-gradient(90deg, var(--cyan), var(--violet));
    color:var(--ink);
    box-shadow:0 10px 30px -10px rgba(139,92,246,0.6);
  }
  .btn-primary:hover{box-shadow:0 14px 36px -8px rgba(139,92,246,0.75);}
  .btn-glass{
    color:var(--text);
  }

  /* preview card */
  .preview-card{
    width:min(880px, 94%);
    padding:10px;
    position:relative;
  }
  .preview-inner{
    border-radius:14px;
    overflow:hidden;
    background:rgba(13,10,26,0.55);
  }
  .preview-topbar{
    display:flex; align-items:center; gap:8px;
    padding:12px 16px;
    border-bottom:1px solid var(--glass-border);
  }
  .preview-topbar .dot{width:10px; height:10px; border-radius:50%; opacity:0.7;}
  .preview-body{padding:28px clamp(18px,4vw,40px); text-align:left;}
  .line{height:10px; border-radius:6px; background:rgba(255,255,255,0.08); margin-bottom:12px;}
  .line.gradient{background:linear-gradient(90deg, rgba(79,209,197,0.5), rgba(139,92,246,0.5));}
  .suggestion-chip{
    display:inline-flex; align-items:center; gap:8px;
    padding:8px 14px;
    border-radius:10px;
    background:rgba(79,209,197,0.12);
    border:1px solid rgba(79,209,197,0.3);
    color:var(--cyan);
    font-size:0.82rem;
    font-weight:500;
    margin-top:14px;
  }

  /* sections */
  section{position:relative; z-index:1; padding:120px 20px;}
  .wrap{max-width:1080px; margin:0 auto;}
  .eyebrow{
    display:inline-block;
    font-size:0.78rem;
    font-weight:600;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--cyan);
    margin-bottom:16px;
  }
  h2{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(1.7rem,3.6vw,2.6rem);
    line-height:1.2;
    max-width:20ch;
    margin:0 0 18px;
  }
  .lede{
    font-size:1.05rem;
    line-height:1.75;
    color:var(--text-dim);
    max-width:58ch;
  }

  /* feature grid */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:20px;
    margin-top:52px;
  }
  .card{
    padding:32px 26px;
    transition:transform .25s ease, background .25s ease;
  }
  .card:hover{transform:translateY(-6px); background:rgba(255,255,255,0.12);}
  .card-icon{
    width:44px; height:44px;
    border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, rgba(79,209,197,0.25), rgba(139,92,246,0.25));
    margin-bottom:18px;
    font-size:1.2rem;
  }
  .card h3{
    font-family:'Space Grotesk',sans-serif;
    font-size:1.15rem;
    margin:0 0 10px;
  }
  .card p{
    font-size:0.92rem;
    line-height:1.65;
    color:var(--text-dim);
    margin:0;
  }

  /* stats strip */
  .stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:1px;
    margin-top:56px;
    padding:0;
    overflow:hidden;
  }
  .stat{
    padding:30px 20px;
    text-align:center;
    border-right:1px solid var(--glass-border);
  }
  .stat:last-child{border-right:none;}
  .stat .num{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:2rem;
    background:linear-gradient(90deg, var(--cyan), var(--violet));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .stat .label{font-size:0.8rem; color:var(--text-dim); margin-top:6px;}

  /* testimonial */
  .quote-card{
    max-width:680px;
    margin:56px auto 0;
    padding:44px clamp(24px,5vw,52px);
    text-align:center;
  }
  .quote-card p{
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(1.1rem,2.4vw,1.4rem);
    line-height:1.6;
    margin:0 0 20px;
  }
  .quote-card .attr{color:var(--text-dim); font-size:0.9rem;}

  /* cta */
  .cta{
    text-align:center;
    max-width:760px;
    margin:0 auto;
    padding:64px clamp(24px,6vw,64px);
  }
  .cta h2{margin-left:auto; margin-right:auto;}
  .cta .lede{margin:0 auto 32px;}

  footer{
    position:relative; z-index:1;
    text-align:center;
    padding:50px 20px 40px;
    color:var(--text-dim);
    font-size:0.85rem;
  }

  .reveal{opacity:0; transform:translateY(20px); transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
</style>
</head>
<body>

<div class="orb orb1"></div>
<div class="orb orb2"></div>

<nav class="nav glass">
  <a href="#top" class="brand">Holly<span>Script</span>X</a>
  <div class="nav-links">
    <a href="#features">About</a>
    <a href="#demo">FAQ</a>
    <a href="https://discord.gg/hsx/" class="nav-cta">Join Our Discord</a>

</div>
</nav>

<section class="hero" id="top">
  <div class="pill glass"><span class="dot"></span> Now reading scripts in real time</div>
  <h1>Best HollScriptX<br>For <span class="grad">INK GAME</span></h1>
  <p class="deck">HollyScriptX reads your script as you write it, catching flat dialogue and pacing issues, then hands back notes instantly — right inside the page.</p>
  <div class="hero-ctas">
    <a href="#cta" class="btn btn-primary">Get Key For Ink Game</a>
    <a href="#demo" class="btn btn-glass glass">Get Scripts</a>
  </div>

  <div class="preview-card glass reveal in" id="previewCard">
    <div class="preview-inner">
      <div class="preview-topbar">
        <span class="dot" style="background:#ff5f57;"></span>
        <span class="dot" style="background:#febc2e;"></span>
        <span class="dot" style="background:#28c840;"></span>
      </div>
      <div class="preview-body">
        <div class="line" style="width:40%;"></div>
        <div class="line" style="width:85%;"></div>
        <div class="line gradient" style="width:70%;"></div>
        <div class="line" style="width:55%;"></div>
        <div class="suggestion-chip">Solara And Xeno For Now Supported, Auto QTE Don't Work</div>
      </div>
    </div>
  </div>
</section>

<section id="features">
  <div class="wrap reveal">
    <span class="eyebrow">About</span>
    <h2>Everything between draft and done</h2>
    <p class="lede">Three passes that turn a rough scene into something worth sending.</p>
  </div>
  <div class="wrap">
    <div class="grid reveal">
      <div class="card glass">
        <div class="card-icon">⚡</div>
        <h3>Always Updated</h3>
        <p>Scripts get patched when games update. Nothing sits broken on the list for long..</p>
      </div>
      <div class="card glass">
        <div class="card-icon">🔑</div>
        <h3>VIP Access</h3>
        <p>Exclusive scripts with key protection. Join the server to get access to premium content.</p>
      </div>
      <div class="card glass">
        <div class="card-icon">🎮</div>
        <h3>Game Coverage</h3>
        <p>Currently covering Ink Game, Doors, and Murder Mystery 2. More games added regularly.</p>
       </div>
      <div class="card glass">
        <div class="card-icon">💬</div>
        <h3>Community</h3>
        <p>Script requests, key drops, and update announcements all happen in the Discord.</p>
</div>
    </div>
    <div class="stats glass reveal">
      <div class="stat"><div class="num display">40k+</div><div class="label">scripts read</div></div>
      <div class="stat"><div class="num display">4K</div><div class="label">Discord Members</div></div>
      <div class="stat"><div class="num display">99%</div><div class="label">Undetected</div></div>
    </div>
  </div>
</section>

<section id="demo">
  <div class="quote-card glass">
  <div class="wrap reveal" style="text-align:center;">
    <span class="eyebrow"></span>
    <h2 style="margin-left:auto; margin-right:auto;">Ink Game, Doors And Murder Mystery 2 Script</h2>
    <div class="quote-card glass">
      <P><a href="https://discord.com/channels/1504482964661076098/1513694879119835246/1513716078298136776" class ="btn btn-primary"> Get Script In Discord</a>
    <div class="attr">— More Update And Add More Games</div>
    </div>
  </div>
</section>

<section id="cta">
  <div class="wrap">
    <div class="cta glass reveal">
      <h2>Key System For 30 hours</h2>
      <p class="lede">Ink Game only for Key System</p>
      <div class="hero-ctas" style="margin-bottom:0;">
        <a href="https://ads.luarmor.net/get_key?for=HollyScriptX__Ink_Game-ltUEROLgDFTZ" class="btn btn-primary">GET KEY</a>
        <a href="https://discord.com/channels/1504482964661076098/1513695025836593243" class="btn btn-glass glass">Or Discord in Key Channel</a>
      </div>
    </div>
  </div>
</section>

<footer>
  Holly<strong style="color:var(--text);">Script</strong>X  By Whonixx
</footer>

<script>
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){ entry.target.classList.add('in'); }
    });
  }, {threshold:0.15});
  document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
</script>

</body>
</html>
